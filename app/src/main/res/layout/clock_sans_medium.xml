<?xml version="1.0" encoding="utf-8"?>
<!--
    The time, drawn as up to three TextClocks so the AM/PM can be a different size without
    spans (some launchers drop them): [lead] is an invisible copy of [trail], which balances it so
    centered digits sit in the middle; [fill] pushes everything left when the time isn't centered.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="horizontal">

    <TextClock
        android:id="@+id/clock_lead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:visibility="gone" />
    <TextClock
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1" />
    <TextClock
        android:id="@+id/clock_trail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1" />
    <TextView
        android:id="@+id/clock_fill"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />
</LinearLayout>
